  "item": [
    {
      "id": "faf379e7-b953-496d-8ac8-f0ccbbd6177e",
      "name": "user",
      "description": {
        "content": "The User APIs allow you to perform operations against Vendasta Users. Each user has a unique identifier in the format UID-{}. This ID is guaranteed to stay the same, while the email associated to a user may change. At any given time, an email is unique to a specific user but over time it is possible for the email to change between user ids.",
        "type": "text/plain"
      },
