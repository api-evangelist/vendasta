            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developers.vendasta.com/api/v1/account/:account_id/file-group/:file_group_id/",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
